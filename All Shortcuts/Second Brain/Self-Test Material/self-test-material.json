            "WFWorkflowActionIdentifier": "is.workflow.actions.gettext",
            "WFWorkflowActionParameters": {
                "WFTextActionText": {
                    "Value": {
                        "string": "Ask me 5 open-ended, short-answer questions to test my understanding of the provided material.\n\nRequirements:\n\n• Questions should require me to recall, explain, apply, or connect ideas from the material—not merely recognize facts.\n• Keep each question short and minimally worded.\n• Do not provide hints or multiple-choice options.\n• After each question, provide its answer, but hide the answer by default using an HTML <details> / <summary> toggle. The answer should only become visible when I expand the toggle. Use exactly this structure for each question:\n\n1. [Question]\n\n<details>\n<summary>Answer</summary>\n\n[Answer]\n\n</details>\n\nKeep answers concise but sufficient to verify whether my response is correct.\n\nBase all questions and answers strictly on the provided material. Do not introduce outside information.\n\n<material>\n￼\n</material>\n",
                        "attachmentsByRange": {
                            "{829, 1}": {
                                "Type": "ExtensionInput"
                            }
                        }
                    },
                    "WFSerializationType": "WFTextTokenString"
                },
